    'db' => [
        'host'     => '127.0.0.1',
        'port'     => 3306,
        'database' => 'civi',
        'user'     => 'civi',
        'password' => '',
        // если MySQL слушает сокет, а не порт, укажите путь и оставьте host пустым
        'socket'   => '',
    ],

    // Хеш пароля админки. Сгенерировать своим паролем:
    //   php tools/make-password-hash.php
    // и вставить сюда полученную строку. Сам пароль нигде не хранится.
    'admin_password_hash' => '',

    // Имя cookie сессии и время жизни в секундах.
    'session_name'     => 'civi_admin',
    'session_lifetime' => 43200,

    // Каталог для загруженных картинок технологий: путь на диске
    // и соответствующий ему адрес в вебе.
    //
    // uploads_url оставьте пустым — адрес вычислится по месту установки:
