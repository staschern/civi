# Админка Civi. Точка входа одна — index.php, маршрут передаётся
# параметром p, поэтому правила преобразования адресов не нужны.

Options -Indexes

DirectoryIndex index.php

# Служебные файлы репозитория наружу не отдаём, даже если каталог
# приложения окажется внутри корня сайта.
<FilesMatch "^\.(git|env)|composer\.(json|lock)$">
    Require all denied
</FilesMatch>
